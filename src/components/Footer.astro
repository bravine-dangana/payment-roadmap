---
import { CookieSettingsButton } from './CookieSettingsButton';
---

<div class="bg-slate-900 py-6 pb-10 text-white sm:py-16">
  <div class="container">
    <div class="flex flex-col justify-between gap-8 lg:flex-row lg:gap-2">
      <div class="max-w-[425px]">
        <p class="text-md flex items-center">
          <a class="inline-flex items-center text-lg font-medium text-white transition-colors hover:text-gray-400" href="/">
            <span>Service Ops</span>
          </a>
        </p>
        <p class="my-4 text-slate-300/60">
          Welcome to Service Ops. Community driven roadmaps, best practices,
          articles and resources to help you grow in the world of payments and fintech.
        </p>
        <div class="text-sm text-gray-400">
          <p>
            &copy; Service Ops {new Date().getFullYear()}
            <span class="mx-1.5">&middot;</span>
            <a href="/terms" class="hover:text-white">Terms</a>
            <span class="mx-1.5">&middot;</span>
            <a href="/privacy" class="hover:text-white">Privacy</a>
          </p>
        </div>
      </div>
    </div>
    <CookieSettingsButton client:load />
  </div>
</div>
