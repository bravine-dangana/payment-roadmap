---
import HeroSection from '../components/HeroSection/HeroSection.astro';
import FeaturedItems from '../components/FeaturedItems/FeaturedItems.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const paymentFlows = [
  { text: 'Digital Banking', url: '/digital-banking' },
  { text: 'Checkout', url: '/checkout' },
  { text: 'Payouts', url: '/payouts' },
  { text: 'Core Platform', url: '/core-platform' },
  { text: 'Tigg Engage', url: '/tigg-engage' },
];

const platformItems = [
  { text: 'Global API Payouts', url: '/global-api-payouts' },
  { text: 'Observability', url: '/observability' },
  { text: 'Checkout Global API', url: '/checkout-global-api' },
  { text: 'Security', url: '/security' },
  { text: 'Infrastructure', url: '/infrastructure' },
];
---
<BaseLayout
  title='Welcome to Service Ops'
  description={'Welcome to Service Ops - Community driven roadmaps and guides for payment professionals.'}
  permalink={'/'}
>
  <div slot='ad-slot-script'></div>
  <div slot='ad-slot'></div>
  <div class='bg-linear-to-b from-slate-900 to-black'>
    <HeroSection />
    <FeaturedItems
      heading='Payment Flows'
      featuredItems={paymentFlows}
      showCreateRoadmap={false}
    />
    <FeaturedItems
      heading='Platform & Infrastructure'
      featuredItems={platformItems}
      showCreateRoadmap={false}
    />
  </div>
</BaseLayout>
