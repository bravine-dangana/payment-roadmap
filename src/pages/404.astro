---
import BaseLayout from '../layouts/BaseLayout.astro';

const legacyRoadmapUrls = [
  '/checkout/', '/digital-banking/', '/payouts/', 
  '/core-platform/', '/tigg-engage/', '/global-api-payouts/',
  '/observability/', '/checkout-global-api/', '/security/', '/infrastructure/'
];
---
<BaseLayout title='Page not found' permalink={'/404'} noIndex={true}>
  <script slot='after-header' define:vars={{ legacyRoadmapUrls }}>
    if (legacyRoadmapUrls.includes(window.location.pathname)) {
      window.location.pathname = window.location.pathname.slice(0, -1);
    }
  </script>
  <div class='flex flex-col items-center justify-center py-20 text-white'>
    <h1 class='text-6xl font-bold text-slate-400'>404</h1>
    <p class='mt-4 text-xl text-slate-500'>Page not found</p>
    <a href='/' class='mt-8 rounded-lg bg-slate-800 px-6 py-3 text-slate-300 hover:bg-slate-700'>
      Go Home
    </a>
  </div>
</BaseLayout>
